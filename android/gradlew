#!/usr/bin/env sh
# Lightweight wrapper bootstrap. Downloads the configured Gradle distribution when needed.
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
DIST_DIR="$GRADLE_USER_HOME/wrapper/dists/gradle-8.14-all/injaz"
GRADLE_BIN="$DIST_DIR/gradle-8.14/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$DIST_DIR"
  ZIP_FILE="$DIST_DIR/gradle-8.14-all.zip"
  if [ ! -f "$ZIP_FILE" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -fL "https://services.gradle.org/distributions/gradle-8.14-all.zip" -o "$ZIP_FILE"
    else
      echo "curl is required to download Gradle 8.14" >&2
      exit 1
    fi
  fi
  unzip -oq "$ZIP_FILE" -d "$DIST_DIR"
fi
exec "$GRADLE_BIN" "$@"
